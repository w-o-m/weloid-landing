# Copy to .env.local and fill in the deployment values. Never commit the real
# .env.local file.

# Server-side base URL for the Weloid FastAPI service, including its API
# prefix. Case and contact intake are sent below this URL.
WELOID_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional. Only set when your deployment platform strips user-supplied values
# and provides one of: cf-connecting-ip, fly-client-ip, x-vercel-forwarded-for.
WELOID_TRUSTED_CLIENT_IP_HEADER=

# Set this to your real production domain once deployed — it drives
# canonical URLs, the sitemap, robots.txt and social preview links.
# Required in production. Use the public origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Optional analytics. Configure these as build-time variables in Coolify.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=
