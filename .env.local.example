# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Never commit the real .env.local file.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Set this to your real production domain once deployed — it drives
# canonical URLs, the sitemap, robots.txt and social preview links.
# Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Password for the /admin cases dashboard. Pick your own — this is not
# a Supabase value.
ADMIN_PASSWORD=choose-a-strong-password

# Project Settings -> API Keys -> "Secret keys" section -> reveal (eye icon)
# and copy the "default" key (starts with sb_secret_...). This is Supabase's
# current name for what used to be called the service_role key — NOT the
# publishable key above, and not the "Legacy anon, service_role" tab.
# Grants full read/write access bypassing RLS — used only by the
# password-gated /admin route to list submissions. Never expose this to the
# browser or commit it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
